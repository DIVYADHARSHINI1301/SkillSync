# Supabase Project Configuration (Synvora / SkillSync)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Backend Microservice URL (optional, defaults to /api proxied via Vite to http://127.0.0.1:8000)
VITE_API_BASE_URL=http://localhost:8000/api
